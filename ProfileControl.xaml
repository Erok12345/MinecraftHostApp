<UserControl x:Class="MinecraftHostApp.ProfileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MaxWidth="720">
        <StackPanel>
            <Button Content="← Назад" Style="{StaticResource SecondaryButton}" Width="120" Height="34"
                    HorizontalAlignment="Left" Margin="0,0,0,20" Click="Back_Click"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Border Width="8" Height="24" Background="{StaticResource AccentGreen}" CornerRadius="2" Margin="0,0,10,0"/>
                <TextBlock Text="Мой профиль" Style="{StaticResource TitleText}"/>
            </StackPanel>

            <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="28" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <Ellipse x:Name="AvatarEllipse" Width="110" Height="110" Margin="0,0,0,14">
                            <Ellipse.Fill><SolidColorBrush Color="#3A3B4A"/></Ellipse.Fill>
                        </Ellipse>
                        <Button Content="Сменить фото" Style="{StaticResource PrimaryButton}" Width="150" Height="34"
                                FontSize="12" Click="ChangeAvatar_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="НИКНЕЙМ" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NicknameText" Grid.Column="0" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Content="Изменить ник" Style="{StaticResource SecondaryButton}" Height="32" FontSize="11.5" Click="ChangeNickname_Click"/>
                        </Grid>

                        <TextBlock Text="UID" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="UidText" Grid.Column="0" Style="{StaticResource SubText}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Content="Скопировать" Style="{StaticResource SecondaryButton}" Height="32" FontSize="11.5" Click="CopyUid_Click"/>
                        </Grid>

                        <TextBlock x:Name="StatusText" Style="{StaticResource SubText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="СЕРВЕРЫ, КОТОРЫЕ Я СОЗДАЛ" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <TextBlock x:Name="CreatedEmptyText" Style="{StaticResource SubText}" FontSize="12" Margin="0,0,0,20" Visibility="Collapsed"
                       Text="Пока не создавал ни одного сервера."/>
            <ItemsControl x:Name="CreatedServersList" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="6" Height="18" Background="{StaticResource AccentGreen}" CornerRadius="2" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubText}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="СЕРВЕРЫ, КУДА ЗАХОДИЛ" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <TextBlock x:Name="JoinedEmptyText" Style="{StaticResource SubText}" FontSize="12" Margin="0,0,0,20" Visibility="Collapsed"
                       Text="Пока не заходил на чужие сервера."/>
            <ItemsControl x:Name="JoinedServersList" Margin="0,0,0,30">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="6" Height="18" Background="{StaticResource TextSecondary}" CornerRadius="2" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubText}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
