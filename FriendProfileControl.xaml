<UserControl x:Class="MinecraftHostApp.FriendProfileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MaxWidth="720">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="← Назад" Style="{StaticResource SecondaryButton}" Width="120" Height="34"
                HorizontalAlignment="Left" Margin="0,0,0,20" Click="Back_Click"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Ellipse x:Name="AvatarEllipse" Width="40" Height="40" Margin="0,0,12,0" Fill="{StaticResource BgCard}"/>
            <Border Width="8" Height="24" Background="{StaticResource AccentGreen}" CornerRadius="2" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="StatusMessage" Margin="0,0,0,10" TextWrapping="Wrap" Style="{StaticResource SubText}"/>
                <ItemsControl x:Name="ServersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="18,14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Id}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding LoaderVersion}" Style="{StaticResource SubText}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
