<Window x:Class="MinecraftHostApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minecraft Rotating Host" Height="700" Width="960" MinWidth="560" MinHeight="500"
        Icon="app_icon.ico"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        SizeChanged="Window_SizeChanged">
    <Grid>
        <!-- ===== ФОНОВЫЕ "СТЕКЛЯННЫЕ" КРУГИ ===== -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="480" Height="480" Canvas.Left="-160" Canvas.Top="-140" Opacity="0.16">
                <Ellipse.Fill><SolidColorBrush Color="#5FBF6B"/></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="420" Height="420" Opacity="0.14" x:Name="BlobTopRight">
                <Ellipse.Fill><SolidColorBrush Color="#5B8CFF"/></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="360" Height="360" Opacity="0.13" x:Name="BlobBottom">
                <Ellipse.Fill><SolidColorBrush Color="#C560E5"/></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="300" Height="300" Opacity="0.10" x:Name="BlobMid">
                <Ellipse.Fill><SolidColorBrush Color="#FFC15F"/></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- ===== ЭКРАН ВХОДА / РЕГИСТРАЦИИ ===== -->
        <StackPanel x:Name="LoginPanel" VerticalAlignment="Center"
                    Width="300" HorizontalAlignment="Center">
            <TextBlock x:Name="AuthTitleText" Text="Minecraft Rotating Host" Style="{StaticResource TitleText}" HorizontalAlignment="Center" Margin="0,0,0,4" TextAlignment="Center"/>
            <TextBlock x:Name="AuthSubText" Text="Войдите, чтобы увидеть серверы" Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <TextBlock x:Name="NicknameLabel" Text="НИКНЕЙМ" Style="{StaticResource FieldLabel}" Visibility="Collapsed"/>
            <TextBox x:Name="NicknameBox" Style="{StaticResource InputBox}" Margin="0,0,0,16" Visibility="Collapsed"/>

            <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="LoginEmailBox" Style="{StaticResource InputBox}" Margin="0,0,0,16"/>

            <TextBlock Text="ПАРОЛЬ" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="LoginPasswordBox" Style="{StaticResource InputPassword}" Margin="0,0,0,24"/>

            <Button x:Name="LoginButton" Content="Войти" Style="{StaticResource PrimaryButton}" Click="Login_Click"/>
            <TextBlock x:Name="LoginStatusText" Margin="0,14,0,0" TextWrapping="Wrap" Style="{StaticResource SubText}" HorizontalAlignment="Center" TextAlignment="Center"/>

            <Button x:Name="ToggleModeButton" Content="Нет аккаунта? Зарегистрироваться" Style="{StaticResource SecondaryButton}"
                    Background="Transparent" FontWeight="Normal" Margin="0,18,0,0" Click="ToggleMode_Click"/>
        </StackPanel>

        <!-- ===== ГЛАВНЫЙ ЭКРАН: БОКОВАЯ ПАНЕЛЬ (у края) + ЦЕНТР (растягивается) ===== -->
        <Grid x:Name="MainPanel" Visibility="Collapsed" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- === Боковая панель профиля (у левого края) === -->
            <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="14" Padding="20" VerticalAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Ellipse x:Name="AvatarEllipse" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,4,0,4" Cursor="Hand"
                             MouseLeftButtonUp="OpenProfile_Click">
                        <Ellipse.Fill><SolidColorBrush Color="#3A3B4A"/></Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Профиль" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Cursor="Hand"
                               HorizontalAlignment="Center" Margin="0,0,0,10" MouseLeftButtonUp="OpenProfile_Click"/>
                    <TextBlock x:Name="ProfileNameText" Text="Игрок" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Изменить ник" FontSize="11.5" Foreground="{StaticResource AccentGreen}" Cursor="Hand"
                               HorizontalAlignment="Center" Margin="0,4,0,10" MouseLeftButtonUp="EditNickname_Click"/>
                    <TextBlock x:Name="UidText" Style="{StaticResource SubText}" FontSize="10" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="Скопировать UID" FontSize="10.5" Foreground="{StaticResource AccentGreen}" Cursor="Hand"
                               HorizontalAlignment="Center" Margin="0,0,0,20" MouseLeftButtonUp="CopyUid_Click"/>

                    <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,0,0,16"/>

                    <Button Content="Обновить список" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" Click="Refresh_Click"/>
                    <Button Content="Создать сервер" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10" Click="New_Click"/>
                    <Button Content="⚙ Настройки" Style="{StaticResource SecondaryButton}" Margin="0,0,0,16" Click="Settings_Click"/>

                    <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,0,0,16"/>

                    <TextBlock Text="ДРУЗЬЯ" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AddFriendBox" Grid.Column="0" Style="{StaticResource InputBox}" Height="30" FontSize="11" ToolTip="UID друга"/>
                        <Button x:Name="AddFriendButton" Grid.Column="2" Content="+" Width="30" Height="30" FontSize="14"
                                Style="{StaticResource PrimaryButton}" Click="AddFriend_Click"/>
                    </Grid>
                    <ItemsControl x:Name="FriendsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgDark}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" Cursor="Hand"
                                        MouseLeftButtonUp="FriendCard_Click" Tag="{Binding Uid}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="22" Height="22" Margin="0,0,8,0"
                                                 Fill="{Binding AvatarBrush}" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextPrimary}"
                                                   FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="✕" Foreground="{StaticResource TextSecondary}" FontSize="12"
                                                   Cursor="Hand" Tag="{Binding Uid}" MouseLeftButtonUp="RemoveFriend_Click" Margin="6,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- === Центр: лобби сервера (поверх списка, когда открыт) === -->
            <ContentControl x:Name="LobbyHost" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Top"/>

            <!-- === Центр: вкладки + фильтры + поиск + список === -->
            <Grid x:Name="ServerListPanel" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Width="8" Height="22" Background="{StaticResource AccentGreen}" CornerRadius="2" Margin="0,0,10,0"/>
                    <TextBlock Text="Серверы" Style="{StaticResource TitleText}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                    <Button x:Name="TabAllButton" Content="Все" Style="{StaticResource PrimaryButton}" Width="90" Height="34" Margin="0,0,8,0" Click="TabAll_Click"/>
                    <Button x:Name="TabMineButton" Content="Мои" Style="{StaticResource SecondaryButton}" Width="90" Height="34" Margin="0,0,20,0" Click="TabMine_Click"/>
                    <ComboBox x:Name="LoaderFilterBox" Style="{StaticResource InputCombo}" Width="130" Height="34" Margin="0,0,8,0" SelectionChanged="Filter_Changed"/>
                    <ComboBox x:Name="VersionFilterBox" Style="{StaticResource InputCombo}" Width="130" Height="34" SelectionChanged="Filter_Changed"/>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="Поиск по названию..." Foreground="{StaticResource TextSecondary}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13.5"/>
                    </Grid>
                    <Button Grid.Column="2" Content="Найти скрытую сеть" Style="{StaticResource SecondaryButton}" Width="170" Click="Find_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <ItemsControl x:Name="ServerList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="18,14" Margin="0,0,0,10"
                                        Cursor="Hand" MouseLeftButtonUp="ServerCard_Click" Tag="{Binding Id}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock Text="{Binding Id}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding LoaderVersion}" Style="{StaticResource SubText}" Margin="0,3,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="11.5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Открыть" Style="{StaticResource PrimaryButton}"
                                                Width="110" VerticalAlignment="Center" Tag="{Binding Id}" Click="Connect_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
