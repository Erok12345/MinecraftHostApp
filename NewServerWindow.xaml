<Window x:Class="MinecraftHostApp.NewServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый сервер" Width="400"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        ResizeMode="NoResize">
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Width="8" Height="22" Background="{StaticResource AccentGreen}" CornerRadius="2" Margin="0,0,10,0"/>
            <TextBlock Text="Новый сервер" Style="{StaticResource TitleText}"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="НАЗВАНИЕ (ID СЕРВЕРА)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" Margin="0,0,0,16"/>

            <TextBlock Text="ЗАГРУЗЧИК" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="LoaderBox" Style="{StaticResource InputCombo}" Margin="0,0,0,16" SelectedIndex="0"
                      SelectionChanged="LoaderBox_SelectionChanged">
                <ComboBoxItem Content="vanilla"/>
                <ComboBoxItem Content="fabric"/>
                <ComboBoxItem Content="forge"/>
            </ComboBox>

            <TextBlock Text="ВЕРСИЯ MINECRAFT" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="VersionBox" Style="{StaticResource InputCombo}" Margin="0,0,0,4"/>
            <TextBlock x:Name="VersionHint" FontSize="11" Style="{StaticResource SubText}" Margin="1,0,0,12"/>

            <TextBlock Text="ПАРОЛЬ ДЛЯ ДРУЗЕЙ" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="PasswordBox" Style="{StaticResource InputBox}" Margin="0,0,0,16"/>

            <CheckBox x:Name="HiddenBox" Content="Скрытый (не показывать в общем списке)"/>

            <TextBlock x:Name="StatusText" Margin="1,16,0,0" TextWrapping="Wrap" Style="{StaticResource SubText}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button x:Name="CreateButton" Content="Создать" Style="{StaticResource PrimaryButton}" Width="120" Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
