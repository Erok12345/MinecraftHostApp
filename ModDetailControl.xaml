<UserControl x:Class="MinecraftHostApp.ModDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MaxWidth="720">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="← Назад к списку" Style="{StaticResource SecondaryButton}" Width="160" Height="34"
                HorizontalAlignment="Left" Margin="0,0,0,20" Click="Back_Click"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="Icon" Grid.Column="0" Width="64" Height="64" Margin="0,0,16,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}"/>
                        <TextBlock x:Name="CompatText" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Style="{StaticResource SubText}" Margin="0,0,0,18"/>

                <StackPanel x:Name="StatusPanel" Margin="0,0,0,18">
                    <TextBlock x:Name="StatusHeader" Text="СТАТУС" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Button x:Name="ActionButton" Grid.Column="1" Width="150" Height="34" FontSize="11.5" Click="ActionButton_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="RequirementsSection" Margin="0,0,0,18">
                    <TextBlock Text="ЧТО ПОНАДОБИТСЯ" Style="{StaticResource FieldLabel}"/>
                    <ItemsControl x:Name="RequirementsList"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="ВСЕ ВЕРСИИ" Style="{StaticResource FieldLabel}"/>
                    <ItemsControl x:Name="VersionsList"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
