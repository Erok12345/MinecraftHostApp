<Window x:Class="MinecraftHostApp.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод" Width="360"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height">
    <Grid Margin="28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Grid.Row="0" Style="{StaticResource FieldLabel}" FontSize="13.5" Margin="1,0,0,10"/>
        <TextBox x:Name="PlainInput" Grid.Row="1" Style="{StaticResource InputBox}"/>
        <PasswordBox x:Name="PassInput" Grid.Row="1" Style="{StaticResource InputPassword}" Visibility="Collapsed"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="100" Height="38" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="OK" Style="{StaticResource PrimaryButton}" Width="100" Height="38" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
